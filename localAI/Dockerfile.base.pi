FROM debian:12-slim

ARG USERNAME
ARG UID
ARG GID

# Install core dependencies
RUN apt update && \
    apt install -y busybox curl fd-find ripgrep tmux && \
    ln -s $(which fdfind) /usr/local/bin/fd && \
    getent group | grep :${GID}: >/dev/null || groupadd --gid ${GID} ${USERNAME} && \
    useradd --uid ${UID} --gid ${GID} --create-home --shell /bin/bash ${USERNAME} && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Pi Agent
RUN npm install -g @mariozechner/pi-coding-agent

USER ${USERNAME}

ENV HOME=/home/${USERNAME}

# General config
ENV COLORTERM=truecolor
ENV TERM=xterm-256color
ENV NO_TELEMETRY=1
ENV DO_NOT_TRACK=1

WORKDIR /home/${USERNAME}

COPY .tmux.conf /home/${USERNAME}/

RUN mkdir -p ${HOME}/.pi/agent/sessions

# --- Trim (build-time-only cruft not needed at runtime) ---
USER root
RUN rm -rf /usr/include/node \
       /root/.npm \
    && apt-get -y autoremove --purge \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && chown -R ${UID}:${GID} /home/${USERNAME}
USER ${USERNAME}

CMD ["bash"]
