# Alpine (musl) variant of the pi coding-agent image.
# Based on the SAME alpine:3.21 as the mathjax image, so the two share a
# common base layer on disk. Node 22 comes from apk. Keep build-time cruft
# out by cleaning in-layer. Preserves the same UID/GID/ownership semantics
# as Dockerfile.base.pi.
FROM alpine:3.21

ARG USERNAME
ARG UID
ARG GID

# Runtime tools for the agent + a proper login shell.
# busybox is built into Alpine, so only the extras are added.
# Reuse a pre-existing group if one already owns GID, else create one
# named ${USERNAME} with that GID (mirrors the Debian groupadd logic).
RUN apk add --no-cache bash curl ripgrep tmux fd nodejs npm && \
    ln -sf /usr/bin/fd /usr/local/bin/fd && \
    if grep -q ":${GID}:" /etc/group; then \
        GNAME="$(awk -F: -v g="${GID}" '$3==g{print $1;exit}' /etc/group)"; \
    else \
        GNAME="${USERNAME}"; \
        addgroup -g ${GID} "${GNAME}"; \
    fi && \
    adduser -D -u ${UID} -G "${GNAME}" -s /bin/bash -h /home/${USERNAME} ${USERNAME}

# Install the Pi Agent globally, then trim everything IN THE SAME LAYER so
# the removed bytes (51MB source maps, koffi platform binaries, docs,
# @types) are actually reclaimed from the image instead of leaving whiteouts.
RUN npm install -g @mariozechner/pi-coding-agent --no-cache && \
    STORE=/usr/local/lib/node_modules/@mariozechner/pi-coding-agent && \
    find /usr/local/lib/node_modules -name '*.map' -type f -delete && \
    rm -rf "$STORE"/docs "$STORE"/examples "$STORE"/CHANGELOG.md && \
    find /usr/local/lib/node_modules -type d -name '@types' -exec rm -rf {} + && \
    find "$STORE"/node_modules/koffi/build/koffi -mindepth 1 -maxdepth 1 -type d ! -name 'musl_x64' -exec rm -rf {} +

USER ${USERNAME}

ENV HOME=/home/${USERNAME} \
    COLORTERM=truecolor \
    TERM=xterm-256color \
    NO_TELEMETRY=1 \
    DO_NOT_TRACK=1

WORKDIR /home/${USERNAME}

COPY .tmux.conf /home/${USERNAME}/

# Working dirs + explicit ownership of the user's home
USER root
RUN mkdir -p /home/${USERNAME}/.pi/agent/sessions && chown -R ${UID}:${GID} /home/${USERNAME}
USER ${USERNAME}

CMD ["bash"]
